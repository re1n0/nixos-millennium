+function M.get_config_dir()
+    local is_win = M.is_windows()
+    if is_win then
+        -- Windows: %STEAM%\ext
+        local steam_path = millennium.steam_path()
+        if steam_path then
+            return fs.join(steam_path, "ext")
+        end
+        return nil
+    else
+        -- Linux: ~/.config/millennium
+        local home = utils.getenv("HOME")
+        local config = utils.getenv("XDG_CONFIG_HOME")
+        if config then
+            return fs.join(config, "millennium")
+        elseif home then
+            return fs.join(home, ".config", "millennium")
+        end
+        return nil
+    end
+end
