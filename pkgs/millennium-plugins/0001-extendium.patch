diff --git a/backend/install_extension/forced.lua b/backend/install_extension/forced.lua
new file mode 100644
index 0000000..e12be68
--- /dev/null
+++ b/backend/install_extension/forced.lua
@@ -0,0 +1,132 @@
+-- Chromium's ExtensionInstallForcelist policy mechanism
+
+local fs = require("fs")
+local json = require("json")
+local utils = require("utils")
+local logger = require("logger")
+
+local config = require("install_extension.config")
+local install_extension = require("install_extension.init")
+
+local M = {}
+
+local FORCED_EXTENSIONS_FILE = "extendium-extensions.json"
+local DEFAULT_UPDATE_URL = "https://clients2.google.com/service/update2/crx"
+
+---Read the list of forced extensions from the plugin directory.
+---@return table[] extensions
+local function read_forced_extensions_list()
+    local config_dir = config.get_config_dir()
+    if not config_dir then
+        return {}
+    end
+
+    local list_path = fs.join(config_dir, FORCED_EXTENSIONS_FILE)
+    if not fs.is_file(list_path) then
+        return {}
+    end
+
+    local content, read_err = utils.read_file(list_path)
+    if not content then
+        logger:error("[forced-extensions] Failed to read " .. list_path .. ": " .. (read_err or "unknown error"))
+        return {}
+    end
+
+    local list, decode_err = json.decode(content)
+    if not list then
+        logger:error("[forced-extensions] Failed to decode " .. list_path .. ": " .. (decode_err or "unknown error"))
+        return {}
+    end
+
+    return list
+end
+
+---@param ext table
+---@return string
+local function build_descriptor_json(ext)
+    if ext.crxPath then
+        return json.encode({
+            external_crx = ext.crxPath,
+            external_version = ext.version,
+        })
+    end
+
+    return json.encode({
+        external_update_url = ext.updateUrl or DEFAULT_UPDATE_URL,
+    })
+end
+
+---Synchronize Steam's "External Extensions" directory with the declarative
+---list in forced-extensions.json. Extensions removed from the list have
+-- their descriptor file deleted; 
+---@return boolean changed
+function M.sync()
+    local extensions = read_forced_extensions_list()
+
+    local config_dir = config.get_steam_config_dir()
+    if not config_dir then
+        logger:error("[forced-extensions] Failed to determine Steam config directory")
+        return false
+    end
+
+    local ext_dir = fs.join(fs.parent_path(config_dir), "External Extensions")
+    if not fs.exists(ext_dir) then
+        local created, create_err = fs.create_directories(ext_dir)
+        if not created then
+            logger:error("[forced-extensions] Failed to create " .. ext_dir .. ": " .. (create_err or "unknown error"))
+            return false
+        end
+    end
+
+    local changed = false
+    local seen_ids = {}
+
+    for _, ext in ipairs(extensions) do
+        if ext.id then
+            seen_ids[ext.id] = true
+
+            local desired = build_descriptor_json(ext)
+            local file_path = fs.join(ext_dir, ext.id .. ".json")
+            local existing = fs.is_file(file_path) and utils.read_file(file_path) or nil
+
+            if existing ~= desired then
+                local success, write_err = utils.write_file(file_path, desired)
+                if success then
+                    logger:info("[forced-extensions] Wrote descriptor for " .. ext.id)
+                    changed = true
+                else
+                    logger:error("[forced-extensions] Failed to write descriptor for " .. ext.id .. ": " .. (write_err or "unknown error"))
+                end
+            end
+        else
+            logger:warn("[forced-extensions] Skipping entry with no id")
+        end
+    end
+
+    local entries = fs.list(ext_dir)
+    if entries then
+        for _, entry in ipairs(entries) do
+            if entry.is_file then
+                local id = entry.name:match("^(.+)%.json$")
+                if id and not seen_ids[id] then
+                    local success, remove_err = fs.remove(entry.path)
+                    if success then
+                        logger:info("[forced-extensions] Removed descriptor for " .. id)
+                        changed = true
+                    else
+                        logger:error("[forced-extensions] Failed to remove descriptor for " .. id .. ": " .. (remove_err or "unknown error"))
+                    end
+                end
+            end
+        end
+    end
+
+    if changed then
+        logger:info("[forced-extensions] Forced extensions changed, restarting Steam webhelper")
+        install_extension.kill_steam_webhelper()
+    end
+
+    return changed
+end
+
+return M
